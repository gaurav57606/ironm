rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. User Root - Owners can only read/write their own profile and keys
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // 2. Events Subcollection - The heart of the event-sourced architecture
      match /events/{eventId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // 3. Snapshots Subcollection - Optional backups
      match /snapshots/{snapshotId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // 4. Device Keys - For HMAC restoration
      match /device_keys/{deviceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // 5. Entitlements - Admin-written, User-read only
    match /entitlements/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == 'FLfAWXAXTvbdF2mHWdoTx129gM63';
    }
  }
}
